<%- include('partials/head') %>

<section class="auth-shell">
  <div class="auth-panel">
    <p class="eyebrow">Teacher area</p>
    <h1>Teacher gateway</h1>
    <p>Enter the teacher password to view worked solutions, assign prompts and build new challenges.</p>
    <% if (authError) { %>
      <p class="form-error"><%= authError %></p>
    <% } %>
    <form method="post" action="/login" class="auth-form">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <label>
        Password
        <input type="password" name="password" autocomplete="current-password" required>
      </label>
      <button class="primary-action" type="submit">Enter teacher area</button>
    </form>
    <% if (passwordHint) { %>
      <p class="small-print"><%= passwordHint %></p>
    <% } %>
    <p class="small-print">Server-side password gate. Use a strong TEACHER_PASSWORD before sharing this with students.</p>
  </div>
</section>

<%- include('partials/footer') %>
