<%- include('partials/head') %>

<section class="auth-shell">
  <div class="auth-panel">
    <p class="eyebrow">Teacher area</p>
    <h1>Teacher gateway</h1>
    <p>For now this opens without details, so you can review worked solutions and assign the next classroom prompts.</p>
    <form method="post" action="/login" class="auth-form">
      <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <button class="primary-action" type="submit">Enter teacher area</button>
    </form>
    <p class="small-print">Prototype access only. Add real server-side authentication before sharing this with students.</p>
  </div>
</section>

<%- include('partials/footer') %>
